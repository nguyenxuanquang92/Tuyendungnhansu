    <bpmn:userTask id="T_LapQD" name="Lập quyết định tuyển dụng">
      <bpmn:incoming>F33</bpmn:incoming>
      <bpmn:outgoing>F34</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:dataStoreReference id="DS_QuyetDinh" name="Quyết định tuyển dụng" />
