      <bpmn:outgoing>F09</bpmn:outgoing>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sendTask id="T_NhacGD" name="Gửi nhắc nhở Giám đốc">
      <bpmn:incoming>F36</bpmn:incoming>
      <bpmn:outgoing>F37</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="E_NhacXong" name="Đã nhắc, chờ duyệt tiếp">
      <bpmn:incoming>F37</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="T_PheDuyet" name="Phê duyệt nhân sự">
      <bpmn:incoming>F30</bpmn:incoming>
      <bpmn:outgoing>F31</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="B_NhacDuyet" name="Quá hạn duyệt 3 ngày" attachedToRef="T_DuyetJD" cancelActivity="false">

      <bpmn:outgoing>F36</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TED_B_NhacDuyet"><bpmn:timeDuration>P3D</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="B_LoiLuuCV" name="Lỗi lưu trữ hồ sơ" attachedToRef="T_LuuCV">

      <bpmn:outgoing>F38</bpmn:outgoing>
      <bpmn:errorEventDefinition id="EED_B_LoiLuuCV" errorRef="Err_LuuCV" />
    </bpmn:boundaryEvent>
    <bpmn:subProcess id="ESP_HuyYC" name="Huỷ yêu cầu tuyển dụng" triggeredByEvent="true">
      <bpmn:startEvent id="ESP_Start" name="Yêu cầu bị huỷ" isInterrupting="true">
        <bpmn:outgoing>EF01</bpmn:outgoing>
        <bpmn:messageEventDefinition id="MED_ESP_Start" messageRef="Msg_HuyYC" />
      </bpmn:startEvent>
      <bpmn:sendTask id="ESP_ThongBao" name="Thông báo huỷ cho các bên">
        <bpmn:incoming>EF01</bpmn:incoming>
        <bpmn:outgoing>EF02</bpmn:outgoing>
      </bpmn:sendTask>
      <bpmn:endEvent id="ESP_End" name="Đã huỷ yêu cầu">
        <bpmn:incoming>EF02</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="EF01" sourceRef="ESP_Start" targetRef="ESP_ThongBao" />
      <bpmn:sequenceFlow id="EF02" sourceRef="ESP_ThongBao" targetRef="ESP_End" />
    </bpmn:subProcess>
