    <bpmn:sendTask id="T_ThongBaoPV" name="Thông báo lịch phỏng vấn">
      <bpmn:incoming>F25</bpmn:incoming>
      <bpmn:outgoing>F26</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="T_GuiKQ" name="Gửi kết quả cho ứng viên">
      <bpmn:incoming>F31</bpmn:incoming>
      <bpmn:outgoing>F32</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="E_XacNhan" name="Nhận xác nhận của ứng viên">
      <bpmn:incoming>F32</bpmn:incoming>
      <bpmn:outgoing>F33</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_E_XacNhan" messageRef="Msg_XacNhan" />
