    </bpmn:laneSet>
    <bpmn:startEvent id="E_NhuCau" name="Nhu cầu tuyển dụng phát sinh">
      <bpmn:outgoing>F01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="T_LapYC" name="Lập yêu cầu tuyển dụng">
      <bpmn:incoming>F01</bpmn:incoming>
      <bpmn:outgoing>F02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:manualTask id="T_BoSung" name="Bổ sung yêu cầu tuyển dụng">
      <bpmn:incoming>F05</bpmn:incoming>
      <bpmn:outgoing>F06</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:dataObject id="DO_D_KeHoach" />
    <bpmn:dataObjectReference id="D_KeHoach" name="Kế hoạch tuyển dụng" dataObjectRef="DO_D_KeHoach" />
    <bpmn:manualTask id="T_PhongVan" name="Phỏng vấn ứng viên">
      <bpmn:incoming>F26</bpmn:incoming>
      <bpmn:outgoing>F27</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="T_DanhGia" name="Đánh giá kết quả phỏng vấn">
      <bpmn:incoming>F27</bpmn:incoming>
      <bpmn:outgoing>F28</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="G_KetQua" name="Kết quả phỏng vấn đạt?">
      <bpmn:incoming>F28</bpmn:incoming>
      <bpmn:outgoing>F29</bpmn:outgoing>
      <bpmn:outgoing>F30</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E_KhongDat" name="Ứng viên không trúng tuyển">
      <bpmn:incoming>F29</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="T_TiepNhan" name="Tiếp nhận và kiểm tra yêu cầu">
      <bpmn:incoming>F02</bpmn:incoming>
      <bpmn:incoming>F06</bpmn:incoming>
      <bpmn:outgoing>F03</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G_DayDu" name="Yêu cầu đã đầy đủ?">
      <bpmn:incoming>F03</bpmn:incoming>
      <bpmn:outgoing>F04</bpmn:outgoing>
      <bpmn:outgoing>F05</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_SoanJD" name="Soạn bản mô tả công việc">
      <bpmn:incoming>F04</bpmn:incoming>
      <bpmn:outgoing>F07</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:dataObject id="DO_D_JD" />
    <bpmn:dataObjectReference id="D_JD" name="Bản JD" dataObjectRef="DO_D_JD" />
    <bpmn:userTask id="T_ChinhJD" name="Chỉnh sửa bản JD">
      <bpmn:incoming>F09</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="G_SS_DangTin" name="">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:sendTask id="T_DangTinNgoai" name="Đăng tin kênh tuyển dụng ngoài">
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="T_DangTinNoiBo" name="Đăng tin cổng thông tin nội bộ">
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F15</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:parallelGateway id="G_SJ_DangTin" name="">
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:outgoing>F16</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:dataObject id="DO_D_ThongBao" />
    <bpmn:dataObjectReference id="D_ThongBao" name="Thông báo tuyển dụng" dataObjectRef="DO_D_ThongBao" />
    <bpmn:eventBasedGateway id="G_SuKien" name="Chờ hồ sơ hoặc hết hạn">
      <bpmn:incoming>F16</bpmn:incoming>
      <bpmn:outgoing>F17</bpmn:outgoing>
      <bpmn:outgoing>F18</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="E_HetHan" name="Hết hạn nhận hồ sơ">
      <bpmn:incoming>F17</bpmn:incoming>
      <bpmn:outgoing>F19</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TED_E_HetHan"><bpmn:timeDuration>P21D</bpmn:timeDuration></bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="E_NhanCV" name="Hồ sơ ứng viên nộp">
      <bpmn:incoming>F18</bpmn:incoming>
      <bpmn:outgoing>F20</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_E_NhanCV" messageRef="Msg_HoSo" />
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="T_LuuCV" name="Lưu hồ sơ vào Kho CV">
      <bpmn:incoming>F19</bpmn:incoming>
      <bpmn:incoming>F20</bpmn:incoming>
      <bpmn:outgoing>F21</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="DS_KhoCV" name="Kho CV" />
    <bpmn:manualTask id="T_LuuTam" name="Lưu tạm và báo lỗi kỹ thuật">
      <bpmn:incoming>F38</bpmn:incoming>
      <bpmn:outgoing>F39</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="T_SangLoc" name="Sàng lọc hồ sơ thủ công">
      <bpmn:incoming>F21</bpmn:incoming>
      <bpmn:outgoing>F22</bpmn:outgoing>
    </bpmn:manualTask>
