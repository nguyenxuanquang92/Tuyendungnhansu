    <bpmn:endEvent id="E_ChoXuLyLai" name="Hồ sơ chờ xử lý lại">
      <bpmn:incoming>F39</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="T_LapLich" name="Lập lịch phỏng vấn">
