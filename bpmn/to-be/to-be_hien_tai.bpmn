    <bpmn:userTask id="Task_ChinhSuaJD" name="Chỉnh sửa JD" />
    <bpmn:sendTask id="Task_DangTin" name="Đăng tin tuyển dụng" />
    <bpmn:subProcess id="SP_SangLoc" name="Tiếp nhận &#38; sàng lọc hồ sơ">
      <bpmn:startEvent id="SP2_Start" />
