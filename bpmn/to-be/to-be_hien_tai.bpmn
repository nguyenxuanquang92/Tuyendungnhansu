      <bpmn:sequenceFlow id="SP2_F6" name="Đạt" sourceRef="SP2_XOR1" targetRef="SP2_LocHoSo" />
      <bpmn:sequenceFlow id="SP2_F7" name="Không đạt" sourceRef="SP2_XOR1" targetRef="SP2_EndLoai1" />
      <bpmn:sequenceFlow id="SP2_F8" sourceRef="SP2_LocHoSo" targetRef="SP2_XOR2" />
      <bpmn:sequenceFlow id="SP2_F9" name="Đạt" sourceRef="SP2_XOR2" targetRef="SP2_EndOK" />
      <bpmn:sequenceFlow id="SP2_F10" name="Không đạt" sourceRef="SP2_XOR2" targetRef="SP2_EndLoai2" />
      <bpmn:textAnnotation id="SP2_Text1">
        <bpmn:text>Hồ sơ đạt khi đáp ứng điều kiện học vấn, kinh nghiệm và từ khóa.</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:textAnnotation id="SP2_Text2">
        <bpmn:text>Hồ sơ đạt khi đáp ứng các tiêu chí bắt buộc về trình độ, kinh nghiệm, kỹ năng theo JD.</bpmn:text>
      </bpmn:textAnnotation>
      <bpmn:association id="SP2_Assoc1" sourceRef="SP2_XOR1" targetRef="SP2_Text1" />
      <bpmn:association id="SP2_Assoc2" sourceRef="SP2_XOR2" targetRef="SP2_Text2" />
    </bpmn:subProcess>
