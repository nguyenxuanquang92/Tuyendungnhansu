        <bpmn:messageEventDefinition messageRef="Message_CV" />
      </bpmn:intermediateCatchEvent>
      <bpmn:intermediateCatchEvent id="SP2_HetHan" name="Hết hạn nộp CV">
        <bpmn:timerEventDefinition />
      </bpmn:intermediateCatchEvent>
      <bpmn:serviceTask id="SP2_LuuCV" name="Lưu CV vào Kho CV">
        <bpmn:dataOutputAssociation id="SP2_DOA_Kho">
          <bpmn:targetRef>SP2_Kho</bpmn:targetRef>
        </bpmn:dataOutputAssociation>
      </bpmn:serviceTask>
