    <bpmn:textAnnotation id="Text_2">
      <bpmn:text>Ứng viên phải xác nhận kết quả trong thời hạn quy định; nếu không, xử lý theo quy định của doanh nghiệp.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_2" sourceRef="Task_NhanKQ" targetRef="Text_2" />
    <bpmn:textAnnotation id="Text_1">
      <bpmn:text>Phiếu yêu cầu phải đủ vị trí, số lượng, lý do và yêu cầu đối với ứng viên.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_1" sourceRef="Task_LapYC" targetRef="Text_1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_TuyenDung" isExecutable="false">
